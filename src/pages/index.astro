---
import SiteLayout from '../layouts/SiteLayout.astro';
import ActionLink from '../components/ActionLink.astro';
import DownloadCTA from '../components/DownloadCTA.astro';
import GuideLinks from '../components/GuideLinks.astro';
import { content, pages, product, site, guides, href } from '../data/site';
const page = pages.home;
const section = (id: string) => {
  const found = page.sections.find(item => item.id === id);
  if (!found) throw new Error(`Missing homepage section: ${id}`);
  return found;
};
const features = section('features');
const plan = section('plans');
const why = section('why');
const audience = section('audience');
const workflow = section('workflow');
const questions = section('questions');
---
<SiteLayout title={page.title} description={page.description} path="/">
  <section class="home-hero" aria-labelledby="hero-heading">
    <div class="shell hero-grid">
      <div class="hero-copy"><p class="eyebrow"><span class="availability-dot" aria-hidden="true"></span>{page.eyebrow}</p><h1 id="hero-heading">{page.heading}{page.headingAccent && <> <span>{page.headingAccent}</span></>}</h1><p class="lead">{page.intro}</p><div class="actions"><ActionLink action={content.common.primaryAction} placement="hero" /><a class="hero-secondary" href="#why">Why Swiftora <span aria-hidden="true">↓</span></a></div><p class="fine-print">{product.downloadNote}</p></div>
      <aside class="hero-handoff" aria-label="Open Swiftora on your iPhone">
        <div class="handoff-heading"><span class="eyebrow">From your next find</span><p>To your<br /><span>next listing.</span></p><div class="handoff-capabilities"><span>Listing assistance</span><span>ROI tracking</span></div></div>
        <div class="handoff-bottom"><a href={site.appStoreUrl} class="qr-link" aria-label="Open Swiftora on the App Store" data-cta="hero-qr"><img src="/assets/qr-app-store.svg" width="152" height="152" alt="" /></a><div><h2>Get Swiftora<br />on your iPhone.</h2><p>Scan to open<br />the App Store.</p><a class="handoff-link" href={site.appStoreUrl} data-cta="hero-handoff">Open App Store <span aria-hidden="true">↗</span></a></div></div>
      </aside>
    </div>
    <div class="shell hero-footnote"><span>THRIFT FLIPPERS · VINTAGE SELLERS · COLLECTORS</span><span class="hero-rule" aria-hidden="true"></span><span>AVAILABLE FOR IPHONE</span></div>
  </section>
  <nav class="home-topics" aria-label="Explore this page"><div class="shell"><span>For the work after the find</span><a href="#why">The why</a><a href="#audience">Who it’s for</a><a href="#features">The app</a><a href="#seller-guides">Seller guides</a></div></nav>
  <section class="home-why section-space" id="why" aria-labelledby="why-heading"><div class="shell why-grid"><div><p class="eyebrow">{why.eyebrow}</p><h2 id="why-heading">{why.heading}</h2></div><div class="why-copy"><p>{why.body}</p>{why.items && <ul>{why.items.map(item => <li><h3>{item.heading}</h3><p>{item.body}</p></li>)}</ul>}{why.action && <a class="text-link" href={href(why.action)}>{why.action.label} <span aria-hidden="true">↗</span></a>}</div></div></section>
  <section class="home-audience section-space" id="audience" aria-labelledby="audience-heading"><div class="shell"><div class="section-intro"><div><p class="eyebrow">{audience.eyebrow}</p><h2 id="audience-heading">{audience.heading}</h2></div><p>{audience.body}</p></div><div class="audience-list">{audience.items?.map((item, index) => <article><span class="audience-number" aria-hidden="true">0{index + 1}</span><div><h3>{item.heading}</h3><p>{item.body}</p></div></article>)}</div>{audience.action && <a class="text-link" href={href(audience.action)}>{audience.action.label} <span aria-hidden="true">↗</span></a>}</div></section>
  <section class="home-features section-space" id="features" aria-labelledby="features-heading">
    <div class="shell"><div class="section-intro"><div><p class="eyebrow">{features.eyebrow}</p><h2 id="features-heading">{features.heading}</h2></div><p>{features.body}</p></div><div class="feature-list">{features.items?.map((item, index) => <article class:list={['feature-panel', index === 0 ? 'feature-listing' : 'feature-roi']}><div class="feature-icon" aria-hidden="true">{index === 0 ? <svg width="28" height="28" viewBox="0 0 28 28" fill="none"><path d="M8 3h10l5 5v17H5V3h3ZM17 3v6h6M9 14h10M9 19h7" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/></svg> : <svg width="28" height="28" viewBox="0 0 28 28" fill="none"><path d="M23 10A10 10 0 1 0 24 16M23 4v6h-6M14 8v12M17 10h-5a2 2 0 0 0 0 4h4a2 2 0 0 1 0 4h-5" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/></svg>}</div><h3>{item.heading}</h3><p>{item.body}</p><a class="text-link feature-caption" href={index === 0 ? '/guides/secondhand-listing-checklist.html' : '/guides/resale-roi-costs.html'}>{index === 0 ? 'What belongs in a resale listing?' : 'What costs belong in your ROI?'} <span aria-hidden="true">↗</span></a></article>)}</div></div>
  </section>
  <section class="home-workflow section-space" id="workflow" aria-labelledby="workflow-heading"><div class="shell workflow-grid"><div><p class="eyebrow">{workflow.eyebrow}</p><h2 id="workflow-heading">{workflow.heading}</h2><p class="workflow-intro">{workflow.body}</p>{workflow.action && <a class="text-link" href={href(workflow.action)}>{workflow.action.label} <span aria-hidden="true">↗</span></a>}</div><ol class="workflow-steps">{workflow.items?.map((item, index) => <li><span aria-hidden="true">0{index + 1}</span><div><h3>{item.heading}</h3><p>{item.body}</p></div></li>)}</ol></div><div class="shell"><div id="how" class="seller-judgment"><strong>You know the item best.</strong><p>Check condition, measurements, authenticity and your asking price before publishing. You choose what to say and what to charge.</p></div></div></section>
  <section class="home-guides section-space" id="seller-guides" aria-labelledby="seller-guides-heading"><div class="shell"><div class="section-intro"><div><p class="eyebrow">The seller’s notebook</p><h2 id="seller-guides-heading">Useful before your<br />next item goes live.</h2></div><div><p>Work through the questions behind<br class="desktop-break" /> a better resale routine.</p><a class="text-link" href="/guides.html">Explore all seller guides <span aria-hidden="true">↗</span></a></div></div><GuideLinks guides={guides} /></div></section>
  <section class="home-questions section-space" id="questions" aria-labelledby="questions-heading"><div class="shell questions-grid"><div><p class="eyebrow">{questions.eyebrow}</p><h2 id="questions-heading">{questions.heading}</h2>{questions.body && <p>{questions.body}</p>}{questions.links && <ul class="resource-links">{questions.links.map(link => <li><a href={href(link)}>{link.label}<span aria-hidden="true"> ↗</span></a></li>)}</ul>}</div><div class="question-list">{questions.items?.map(item => <details><summary>{item.heading}</summary><p>{item.body}</p></details>)}</div></div></section>
  <section class="home-pricing section-space" aria-labelledby="plans-heading"><div class="shell pricing-strip"><div><p class="eyebrow">{plan.eyebrow}</p><h2 id="plans-heading">{plan.heading}</h2></div><div><p>{plan.body}</p>{plan.action && <a class="text-link" href="/pricing.html">{plan.action.label} <span aria-hidden="true">↗</span></a>}</div></div></section>
  <DownloadCTA legacy compact />
</SiteLayout>
