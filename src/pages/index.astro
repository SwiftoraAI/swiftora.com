---
import SiteLayout from '../layouts/SiteLayout.astro';
import ActionLink from '../components/ActionLink.astro';
import DownloadCTA from '../components/DownloadCTA.astro';
import { content, pages, product, site } from '../data/site';
const page = pages.home;
const features = product.features;
const plan = page.sections[1];
---
<SiteLayout title={page.title} description={page.description} path="/">
  <section class="home-hero" aria-labelledby="hero-heading">
    <div class="shell hero-grid">
      <div class="hero-copy"><p class="eyebrow"><span class="availability-dot" aria-hidden="true"></span>{page.eyebrow}</p><h1 id="hero-heading">Listing help for<br /><span>secondhand sellers.</span></h1><p class="lead">{page.intro}</p><div class="actions"><ActionLink action={content.common.primaryAction} placement="hero" /><a class="hero-secondary" href="#features">What’s in the app <span aria-hidden="true">↓</span></a></div><p class="fine-print">{product.downloadNote}</p></div>
      <aside class="hero-handoff" aria-label="Open Swiftora on your iPhone">
        <div class="handoff-heading"><span class="eyebrow">From your next find</span><p>To your<br /><span>next listing.</span></p><div class="handoff-capabilities"><span>Listing assistance</span><span>ROI tracking</span></div></div>
        <div class="handoff-bottom"><a href={site.appStoreUrl} class="qr-link" aria-label="Open Swiftora on the App Store" data-cta="hero-qr"><img src="/assets/qr-app-store.svg" width="152" height="152" alt="" /></a><div><h2>Get Swiftora<br />on your iPhone.</h2><p>Scan to open<br />the App Store.</p><a class="handoff-link" href={site.appStoreUrl} data-cta="hero-handoff">Open App Store <span aria-hidden="true">↗</span></a></div></div>
      </aside>
    </div>
    <div class="shell hero-footnote"><span>BUILT FOR SECONDHAND SELLERS</span><span class="hero-rule" aria-hidden="true"></span><span>AVAILABLE FOR IPHONE</span></div>
  </section>
  <section class="home-features section-space" id="features" aria-labelledby="features-heading">
    <div class="shell"><div class="section-intro"><div><p class="eyebrow">Inside Swiftora</p><h2 id="features-heading">Listings and ROI.<br />Room to focus.</h2></div><p>Two parts of your resale work,<br class="desktop-break" /> together on your iPhone.</p></div><div class="feature-list">{features.map((item, index) => <article class:list={['feature-panel', index === 0 ? 'feature-listing' : 'feature-roi']}><div class="feature-icon" aria-hidden="true">{index === 0 ? <svg width="28" height="28" viewBox="0 0 28 28" fill="none"><path d="M8 3h10l5 5v17H5V3h3ZM17 3v6h6M9 14h10M9 19h7" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/></svg> : <svg width="28" height="28" viewBox="0 0 28 28" fill="none"><path d="M23 10A10 10 0 1 0 24 16M23 4v6h-6M14 8v12M17 10h-5a2 2 0 0 0 0 4h4a2 2 0 0 1 0 4h-5" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/></svg>}</div><h3>{item.title}</h3><p>{item.description}</p><span class="feature-caption">{index === 0 ? 'For the items you sell' : 'For the numbers behind them'}</span></article>)}</div><div id="how" class="review-note"><span class="review-label">Before you publish</span><p>Check the item’s condition, measurements and other details. You choose what to say and what to charge.</p><a class="text-link" href="/demo.html">Get started <span aria-hidden="true">↗</span></a></div></div>
  </section>
  <section class="home-pricing section-space" aria-labelledby="plans-heading"><div class="shell pricing-strip"><div><p class="eyebrow">{plan.eyebrow}</p><h2 id="plans-heading">{plan.heading}</h2></div><div><p>{plan.body}</p>{plan.action && <a class="text-link" href="/pricing.html">{plan.action.label} <span aria-hidden="true">↗</span></a>}</div></div></section>
  <DownloadCTA legacy compact />
</SiteLayout>
