---
import SiteLayout from '../layouts/SiteLayout.astro';
import ActionLink from '../components/ActionLink.astro';
import DownloadCTA from '../components/DownloadCTA.astro';
import { content, pages, product, site } from '../data/site';
const page = pages.home;
const features = page.sections[0];
const plan = page.sections[1];
---
<SiteLayout title={page.title} description={page.description} path="/">
  <section class="home-hero" aria-labelledby="hero-heading">
    <div class="shell hero-grid">
      <div class="hero-copy"><p class="eyebrow"><span class="availability-dot" aria-hidden="true"></span>{page.eyebrow}</p><h1 id="hero-heading">For the finds<br /><span>you sell.</span></h1><p class="lead">{page.intro}</p><div class="actions"><ActionLink action={content.common.primaryAction} placement="hero" /><a class="hero-secondary" href="#features">Explore Swiftora <span aria-hidden="true">↓</span></a></div><p class="fine-print">{product.downloadNote}</p></div>
      <aside class="hero-handoff" aria-label="Open Swiftora on your iPhone">
        <div class="handoff-heading"><span class="eyebrow">Made for your resale routine</span><p>A little help.<br />A lot of possibility.</p></div>
        <div class="handoff-bottom"><a href={site.appStoreUrl} class="qr-link" aria-label="Open Swiftora on the App Store" data-cta="hero-qr"><img src="/assets/qr-app-store.svg" width="152" height="152" alt="" /></a><div><h2>Open on<br />your iPhone.</h2><p>Scan to find Swiftora<br />on the App Store.</p><span class="handoff-arrow" aria-hidden="true">↗</span></div></div>
      </aside>
    </div>
    <div class="shell hero-footnote"><span>LISTING ASSISTANCE</span><span aria-hidden="true">+</span><span>ROI TRACKING</span><span class="hero-rule" aria-hidden="true"></span><span>SWIFTORA / IPHONE</span></div>
  </section>
  <section class="home-features section-space" id="features" aria-labelledby="features-heading">
    <div class="shell"><div class="section-intro"><p class="eyebrow">{features.eyebrow}</p><h2 id="features-heading">{features.heading}</h2></div><div class="feature-list">{features.items?.map((item, index) => <div class="feature-row"><span class="feature-number" aria-hidden="true">{String(index + 1).padStart(2,'0')}</span><h3>{item.heading}</h3><p>{item.body}</p><span class="feature-plus" aria-hidden="true">{index === 0 ? '↗' : index === 1 ? '＋' : '✓'}</span></div>)}</div></div>
  </section>
  <section id="how" class="home-how section-space" aria-labelledby="how-heading"><div class="shell how-grid"><div><p class="eyebrow">A simple next step</p><h2 id="how-heading">Take a look.<br />Make it part<br />of your day.</h2></div><div class="how-copy"><p>Explore Swiftora on iPhone, find current plan details in the app, and keep your own knowledge of each item at the center of your work.</p><a class="text-link" href="/demo.html">Get started with Swiftora <span aria-hidden="true">↗</span></a><div class="review-note"><span aria-hidden="true">✳</span><p>Check the condition, measurements and other details before publishing. You choose what to say and what to charge.</p></div></div></div></section>
  <section class="home-pricing section-space" aria-labelledby="plans-heading"><div class="shell pricing-strip"><div><p class="eyebrow">{plan.eyebrow}</p><h2 id="plans-heading">{plan.heading}</h2></div><div><p>{plan.body}</p>{plan.action && <a class="text-link" href="/pricing.html">{plan.action.label} <span aria-hidden="true">↗</span></a>}</div></div></section>
  <DownloadCTA legacy compact />
</SiteLayout>
