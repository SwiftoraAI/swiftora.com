---
import { href, type Action } from '../data/site';
interface Props { action: Action; secondary?: boolean; placement?: string; class?: string }
const { action, secondary = false, placement = 'body', class: className = '' } = Astro.props;
---
<a href={href(action)} class:list={['button', { 'button-secondary': secondary }, className]} data-cta={placement}>
  <span>{action.label}</span>
  <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" fill="none"><path d="M5 12h14M13 6l6 6-6 6" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/></svg>
</a>
